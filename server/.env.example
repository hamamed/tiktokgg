# Copy to .env (or export these) — all optional.
PORT=8080
HOST=0.0.0.0
# Shared secret clients must pass as ?token=... (leave empty to disable auth on a trusted LAN)
WS_TOKEN=
# Euler Stream sign API key (recommended for tiktok-live-connector v2 to avoid rate limits)
TIKTOK_SIGN_API_KEY=
# Swap the connector package, e.g. a fork: @ycryptx/tiktok-live-connector
TIKTOK_CONNECTOR_PKG=tiktok-live-connector
# Streaks with no repeatEnd after this many ms are force-closed
STREAK_TIMEOUT_MS=30000
LOG_LEVEL=info
